# Exercise 
def find_number(numbers, target):
    left = 0
    right = len(numbers) -1 
    while left <= right:
        mid = (left + right) // 2
        if numbers[mid] == target:
            return mid
        elif numbers[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1
