#Loops 
# It let's us to repeat a block of code multiple times.
for i  in range(5):
    print(i)
#Addition inside loop
for i in range(1,6):
    print(i + 10)
# If inside a loop
for i in range(1,7):
    if i % 4 == 0:
        print(i)
# While loop
# keep repeating while a condition is true.
# use for loop when you know how many times you want to repeat a block of code.
# use while loop when you don't know how many times you want to repeat a block of code.
# break
for i in range (1,10):
    if i == 5:
        break
    print(i)
# continue
for i in range(1,10):
    if i == 5:
        continue
    print(i)
